# Másold deploy/.env néven, és töltsd ki. A deploy/.env nincs verziókövetve.

# Adatbázis-jelszó (a db konténer és az app közös titka); URL-biztos legyen, pl.: openssl rand -hex 24
POSTGRES_PASSWORD=
# Munkamenet-süti aláírása, legalább 32 bájt, pl.: openssl rand -base64 48
SESSION_SECRET=
PUBLIC_BASE_URL=http://localhost:8080
TZ_DISPLAY=Europe/Budapest
# Bekapcsolt modulok vesszővel (pl. docs,notes); * = mind
DERP_MODULES=*

# Google-belépés (OpenID Connect); ha üres, csak a dev-login él (az pedig productionben tiltott)
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# Opcionális: a hoszt portja (alapból 8080)
# DERP_HOST_PORT=8080
# Opcionális: az adatbázis könyvtára a hoszton; alapból névvel ellátott kötet
# DERP_DB_DIR=
# Opcionális: képcímke (visszaálláshoz a korábbi címkére)
# DERP_IMAGE_TAG=latest
