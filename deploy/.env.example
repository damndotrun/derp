# Másold deploy/.env néven, és töltsd ki. A deploy/.env nincs verziókövetve.

# Adatbázis-jelszó (a db konténer és az app közös titka); URL-biztos legyen, pl.: openssl rand -hex 24
POSTGRES_PASSWORD=
# Munkamenet-süti aláírása, legalább 32 bájt, pl.: openssl rand -base64 48
SESSION_SECRET=
PUBLIC_BASE_URL=http://localhost:8080
TZ_DISPLAY=Europe/Budapest

# Opcionális: az adatbázis könyvtára a hoszton (pl. /mnt/Tank/data/derp/db); alapból névvel ellátott kötet
# DERP_DB_DIR=
# Opcionális: képcímke (visszaálláshoz a korábbi címkére)
# DERP_IMAGE_TAG=latest
